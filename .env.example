# ==================== LLM Configuration ====================
# Ollama endpoint URL
OLLAMA_ENDPOINT=http://localhost:11434

# Model name (available via: ollama list)
MODEL_NAME=qwen2.5:3b-instruct
# Alternatives: phi3:mini, llama3.2:3b-instruct

# LLM Generation Parameters (keep temperature at 0 for determinism!)
TEMPERATURE=0.0
TOP_P=1.0
TOP_K_SAMPLING=1
REPEAT_PENALTY=1.0
MAX_TOKENS=384

# ==================== Embedding Configuration ====================
# Sentence transformer model for embeddings
EMBED_MODEL=all-MiniLM-L6-v2

# Cache size for frequent query embeddings
EMBEDDING_CACHE_SIZE=1000

# ==================== Retrieval Configuration ====================
# Number of candidate documents to retrieve
TOP_K=4

# Similarity threshold (0.0-1.0, higher = stricter)
SIMILARITY_THRESHOLD=0.75

# ==================== Input Validation Configuration ====================
# Maximum question length in characters (prevents DoS attacks)
MAX_QUESTION_LENGTH=500

# Maximum document length in characters (prevents memory issues)
MAX_DOCUMENT_LENGTH=10000

# ==================== Vector Store Configuration ====================
# Vector store type (currently only 'chroma' supported)
VECTOR_STORE_TYPE=chroma

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=.chroma

# Collection name
COLLECTION_NAME=faq

# ==================== API Configuration ====================
# API server host
API_HOST=0.0.0.0

# API server port
API_PORT=8000

# Number of worker processes (1 for development, 4+ for production)
API_WORKERS=1

# ==================== Security Configuration ====================
# Authentication (optional API key requirement)
REQUIRE_AUTH=false

# Rate limiting
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=10

# ==================== CORS Configuration ====================
# Enable CORS (true/false)
ENABLE_CORS=true

# Allowed origins (comma-separated)
# Default: localhost only for security
# For production, specify exact origins like: https://yourdomain.com,https://app.yourdomain.com
# WARNING: Using * allows ALL origins (insecure for production!)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==================== Logging ====================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
